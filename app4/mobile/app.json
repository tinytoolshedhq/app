{
  "expo": {
    "name": "Decibel Meter",
    "slug": "decibel-meter",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tinytoolshed.decibelmeter",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh-Hant"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "The microphone is needed to measure sound level on this device. A temporary recording is deleted right away. Nothing is saved or sent.",
        "NSPhotoLibraryUsageDescription": "This app does not access your photos. This text is required by a system component.",
        "NSPhotoLibraryAddUsageDescription": "Only used when you choose to save an exported image to your photo library."
      }
    },
    "android": {
      "package": "com.tinytoolshed.decibelmeter",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#163A3A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is needed to measure sound level on this device. A temporary recording is deleted right away. Nothing is saved or sent.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hant"
            ],
            "android": [
              "en",
              "zh-Hant",
              "zh-TW",
              "zh-HK"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-iap"
    ],
    "locales": {
      "en": "./languages/ios/en.json",
      "zh-Hant": "./languages/ios/zh-Hant.json",
      "zh-TW": "./languages/ios/zh-Hant.json",
      "zh-HK": "./languages/ios/zh-Hant.json"
    },
    "owner": "leowang1105",
    "extra": {
      "eas": {
        "projectId": "117e579d-6aec-40ea-8e97-19bc314debcb"
      }
    }
  }
}
