{
  "name": "stretch",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:ios:preview": "eas build --platform ios --profile preview-ios-sim",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.7",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-build-properties": "57.0.22",
    "expo-constants": "~57.0.22",
    "expo-iap": "^5.3.1",
    "expo-keep-awake": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "node-forge": "^1.3.1",
    "argparse": "^2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "audit-ci": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "ciScripts": {
    "auditHigh": "npx audit-ci --config audit-ci.json"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.expo/",
      "<rootDir>/.expo-shared/"
    ]
  }
}
